      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• RESTO_IDENT   FIRST={ATRIB}                          FOLLOW={PONTO_VIRG}\n• EXP_IDENT     FIRST={ABRE_PAR, LER_DOUBLE, MENOS, NUMERO_REAL, ID} FOLLOW={PONTO_VIRG}\n• CONDICAO      FIRST={ABRE_PAR, MENOS, NUMERO_REAL, ID} FOLLOW={FECHA_PAR}\n• RELACAO       FIRST={NE, GE, LT, EQ, LE, GT}         FOLLOW={ABRE_PAR, MENOS, NUMERO_REAL, ID}\n• EXPRESSAO     FIRST={ABRE_PAR, MENOS, NUMERO_REAL, ID} FOLLOW={PONTO_VIRG, NE, GE, LT, EQ, LE, FECHA_PAR, GT}\n• TERMO         FIRST={ABRE_PAR, MENOS, NUMERO_REAL, ID} FOLLOW={PONTO_VIRG, NE, MAIS, GE, LT, EQ, LE, FECHA_PAR, MENOS, GT}\n• OP_UN         FIRST={MENOS}                          FOLLOW={ABRE_PAR, NUMERO_REAL, ID}\n• FATOR         FIRST={ABRE_PAR, NUMERO_REAL, ID}      FOLLOW={PONTO_VIRG, NE, MULT, MAIS, GE, LT, EQ, LE, FECHA_PAR, MENOS, GT, DIV}\n• OUTROS_TERMOS FIRST={MAIS, MENOS}                    FOLLOW={PONTO_VIRG, NE, GE, LT, EQ, LE, FECHA_PAR, GT}\n• OP_AD         FIRST={MAIS, MENOS}                    FOLLOW={ABRE_PAR, MENOS, NUMERO_REAL, ID}\n• MAIS_FATORES  FIRST={MULT, DIV}                      FOLLOW={PONTO_VIRG, NE, MAIS, GE, LT, EQ, LE, FECHA_PAR, MENOS, GT}\n• OP_MUL        FIRST={MULT, DIV}                      FOLLOW={ABRE_PAR, NUMERO_REAL, ID}",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "• RESTO_IDENT   FIRST={ATRIB}                          FOLLOW={PONTO_VIRG}\n• EXP_IDENT     FIRST={ABRE_PAR, LER_DOUBLE, MENOS, NUMERO_REAL, ID} FOLLOW={PONTO_VIRG}\n• CONDICAO      FIRST={ABRE_PAR, MENOS, NUMERO_REAL, ID} FOLLOW={FECHA_PAR}\n• RELACAO       FIRST={NE, GE, LT, EQ, LE, GT}         FOLLOW={ABRE_PAR, MENOS, NUMERO_REAL, ID}\n• EXPRESSAO     FIRST={ABRE_PAR, MENOS, NUMERO_REAL, ID} FOLLOW={PONTO_VIRG, NE, GE, LT, EQ, LE, FECHA_PAR, GT}\n• TERMO         FIRST={ABRE_PAR, MENOS, NUMERO_REAL, ID} FOLLOW={PONTO_VIRG, NE, MAIS, GE, LT, EQ, LE, FECHA_PAR, MENOS, GT}\n• OP_UN         FIRST={MENOS}                          FOLLOW={ABRE_PAR, NUMERO_REAL, ID}\n• FATOR         FIRST={ABRE_PAR, NUMERO_REAL, ID}      FOLLOW={PONTO_VIRG, NE, MULT, MAIS, GE, LT, EQ, LE, FECHA_PAR, MENOS, GT, DIV}\n• OUTROS_TERMOS FIRST={MAIS, MENOS}                    FOLLOW={PONTO_VIRG, NE, GE, LT, EQ, LE, FECHA_PAR, GT}\n• OP_AD         FIRST={MAIS, MENOS}                    FOLLOW={ABRE_PAR, MENOS, NUMERO_REAL, ID}\n• MAIS_FATORES  FIRST={MULT, DIV}                      FOLLOW={PONTO_VIRG, NE, MAIS, GE, LT, EQ, LE, FECHA_PAR, MENOS, GT}\n• OP_MUL        FIRST={MULT, DIV}                      FOLLOW={ABRE_PAR, NUMERO_REAL, ID}",
      "lineHeight": 1.25
    },
