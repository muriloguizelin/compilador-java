      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1. Estado 25: Leu CMDS\n2. SHIFT 37 no token '}'\n3. Estado 37 -> SHIFT 53 '}'\n4. REDUCE R1 (PROG)\n5. GOTO PROG em Estado 0 = 2\n6. Estado 2 com token '$' (EOF):\n   ===> ACCEPT! (SUCESSO)",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "1. Estado 25: Leu CMDS\n2. SHIFT 37 no token '}'\n3. Estado 37 -> SHIFT 53 '}'\n4. REDUCE R1 (PROG)\n5. GOTO PROG em Estado 0 = 2\n6. Estado 2 com token '$' (EOF):\n   ===> ACCEPT! (SUCESSO)",
      "lineHeight": 1.25
    },
