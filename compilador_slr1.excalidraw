    {
      "id": "152fdd0248",
      "type": "text",
      "x": 1635,
      "y": 2192,
      "width": 359.99999999999994,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#c084fc",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 10104,
