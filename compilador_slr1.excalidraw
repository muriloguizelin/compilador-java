      "locked": false,
      "text": "1. SHIFT (Deslocamento)",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "1. SHIFT (Deslocamento)",
      "lineHeight": 1.25
    },
    {
      "id": "9de366aead",
      "type": "text",
      "x": 1645,
      "y": 1318,
      "width": 438.0,
      "height": 39.0,
      "angle": 0,
      "strokeColor": "#f1f5f9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
