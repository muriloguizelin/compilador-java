      "text": "LISTA DETALHADA E COMPLETA DE FIRST E FOLLOW:",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "LISTA DETALHADA E COMPLETA DE FIRST E FOLLOW:",
      "lineHeight": 1.25
    },
    {
      "id": "2a3315a608",
      "type": "text",
      "x": 835,
      "y": 1393,
      "width": 630.0,
      "height": 156.0,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1087,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• START         FIRST={PUBLIC}                         FOLLOW={EOF}\n• PROG          FIRST={PUBLIC}                         FOLLOW={EOF}\n• DC            FIRST={DOUBLE}                         FOLLOW={FECHA_CHAVE}\n• VAR           FIRST={DOUBLE}                         FOLLOW={PONTO_VIRG}\n• VARS          FIRST={ID}                             FOLLOW={PONTO_VIRG}\n• MAIS_VAR      FIRST={VIRGULA}                        FOLLOW={PONTO_VIRG}\n• TIPO          FIRST={DOUBLE}                         FOLLOW={ID}\n• CMDS          FIRST={DOUBLE, IF, WHILE, PRINT, ID}   FOLLOW={FECHA_CHAVE}\n• MAIS_CMDS     FIRST={PONTO_VIRG}                     FOLLOW={FECHA_CHAVE}\n• CMD_COND      FIRST={IF, WHILE}                      FOLLOW={DOUBLE, FECHA_CHAVE, IF, WHILE, PRINT, ID}\n• CMD           FIRST={PRINT, ID}                      FOLLOW={PONTO_VIRG}\n• PFALSA        FIRST={ELSE}                           FOLLOW={DOUBLE, FECHA_CHAVE, IF, WHILE, PRINT, ID}",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "• START         FIRST={PUBLIC}                         FOLLOW={EOF}\n• PROG          FIRST={PUBLIC}                         FOLLOW={EOF}\n• DC            FIRST={DOUBLE}                         FOLLOW={FECHA_CHAVE}\n• VAR           FIRST={DOUBLE}                         FOLLOW={PONTO_VIRG}\n• VARS          FIRST={ID}                             FOLLOW={PONTO_VIRG}\n• MAIS_VAR      FIRST={VIRGULA}                        FOLLOW={PONTO_VIRG}\n• TIPO          FIRST={DOUBLE}                         FOLLOW={ID}\n• CMDS          FIRST={DOUBLE, IF, WHILE, PRINT, ID}   FOLLOW={FECHA_CHAVE}\n• MAIS_CMDS     FIRST={PONTO_VIRG}                     FOLLOW={FECHA_CHAVE}\n• CMD_COND      FIRST={IF, WHILE}                      FOLLOW={DOUBLE, FECHA_CHAVE, IF, WHILE, PRINT, ID}\n• CMD           FIRST={PRINT, ID}                      FOLLOW={PONTO_VIRG}\n• PFALSA        FIRST={ELSE}                           FOLLOW={DOUBLE, FECHA_CHAVE, IF, WHILE, PRINT, ID}",
      "lineHeight": 1.25
    },
    {
      "id": "1c95644bf0",
      "type": "text",
      "x": 835,
      "y": 1593,
      "width": 798.0,
      "height": 156.0,
      "angle": 0,
      "strokeColor": "#cbd5e1",
